# Normaliza finales de línea: LF en el repositorio, lo que corresponda en cada
# máquina al hacer checkout. Sin esto, un mismo archivo editado en Windows y en
# Linux aparece como "cambiado por completo" en el diff.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# El lockfile es generado: colapsarlo en los diffs y no contarlo como código.
package-lock.json linguist-generated=true -diff
